# Environment variables for the FastAPI AI service.
# Copy this file to .env and fill in the values.

# ── Server ─────────────────────────────────────────────────────────────────────
# Port the Uvicorn server will listen on (also set via CLI --port flag)
PORT=8000

# ── Debug mode ─────────────────────────────────────────────────────────────────
# Set to "true" during development to enable:
#   - GET /debug/preview/{id}?stage=original|processed
#   - "debugId" field in POST /process response
#
# WARNING: Never set this to "true" in production.
# The debug endpoint is hidden from Swagger docs when DEBUG_MODE is false.
DEBUG_MODE=false

# ── Tesseract OCR ──────────────────────────────────────────────────────────────
# Path to the Tesseract executable.
# Leave empty to use the system PATH (i.e., if `tesseract` is already on PATH).
#
# Windows default installer path:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#
# Download Tesseract for Windows:
#   https://github.com/UB-Mannheim/tesseract/wiki
#
# If this is unset AND tesseract is not on PATH, /process will still succeed
# but the "ocr" block will have success=false with a clear error message.
TESSERACT_CMD=

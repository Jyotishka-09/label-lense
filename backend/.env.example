# Environment variables for the Express backend
# Copy this file to .env and fill in the values.

# Port the Express server will listen on
PORT=5000

# URL of the React frontend
FRONTEND_URL=http://localhost:5173

# URL of the FastAPI AI service
AI_SERVICE_URL=http://localhost:8001

# MongoDB connection string (not used yet — will be added later)
# MONGO_URI=mongodb://localhost:27017/labellens
